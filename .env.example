# --- Nimble: daily crawl of bank rate pages ----------------------------------
NIMBLE_API_KEY=

# --- Liquid AI: turns crawled HTML into structured rate rows -----------------
# Liquid publishes weights rather than running a hosted inference API, so the
# models are reached through OpenRouter, which is OpenAI-compatible. Get a key
# at openrouter.ai/keys. Optional: without it the selector parser in
# lib/rates/selectors.ts handles the sources it has selectors for.
#   liquid/lfm-2.5-2.6b:free       free on OpenRouter — the default
#   (the :free suffix matters — without it OpenRouter 404s)
#   liquid/lfm-2.5-1.2b-instruct   smallest of the current line
#   liquid/lfm-2-24b-a2b           largest, best on messy pages
# LIQUID_URL can point at any OpenAI-compatible server — a local Ollama or
# vLLM running the same weights works unchanged.
LIQUID_API_KEY=
LIQUID_MODEL=liquid/lfm-2.5-2.6b:free
# LIQUID_URL=http://localhost:11434/v1/chat/completions

# --- Plaid sandbox: account linking + simulated ACH --------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- RawTree: the ledger, and the raw crawl landing zone ---------------------
# Without RAWTREE_API_KEY the app serves deterministic seeded data, so the UI
# always works.
# Keys are scoped to an org and cluster, not a single database, so a request
# picks the database explicitly. Needs write permission: a "Read only" key
# cannot ingest, and creating a NEW database needs Admin — so use one that
# already exists on your cluster. List them with:
#   curl -H "Authorization: Bearer $RAWTREE_API_KEY" https://api.rawtree.com/v1/databases
# Verify the whole setup with: npm run rawtree:check
RAW_SINK=file
RAWTREE_API_KEY=
RAWTREE_DATABASE=default

# --- Black Forest Labs: site imagery (npm run images) ------------------------
# Auth is an x-key header, not a bearer token. Generation is async and the
# finished URL expires in ~10 minutes. Images are generated once and committed,
# so this key is only needed when regenerating them.
BFL_API_KEY=
BFL_MODEL=flux-pro-1.1

# --- Protects /api/cron/daily once deployed ----------------------------------
CRON_SECRET=
