DESCRIPTION >
    Day-by-day map of where a customer's money sat and what it earned there.
    This is the row-per-day feed behind the timeline strip in the UI.

TOKEN "dashboard_read" READ

NODE endpoint
SQL >
    %
    SELECT
        date,
        bankId,
        apr,
        principalCents,
        accruedCents,
        sum(accruedCents) OVER (ORDER BY date) AS cumulativeCents
    FROM daily_accruals
    WHERE customerId = {{ String(customerId, 'cus_demo') }}
      AND date >= {{ Date(since, '2026-01-01') }}
    ORDER BY date

TYPE endpoint
