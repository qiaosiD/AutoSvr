DESCRIPTION >
    Headline numbers for the dashboard. blendedApy is the annualized
    daily-compounded chain of every APR the customer actually earned —
    not the average of those APRs, which would misstate a moving-rate path.

TOKEN "dashboard_read" READ

NODE endpoint
SQL >
    %
    SELECT
        count() AS daysInvested,
        sum(accruedCents) AS totalAccruedCents,
        argMax(principalCents, date) AS principalCents,
        argMax(bankId, date) AS currentBankId,
        argMax(apr, date) AS currentApr,
        exp(sum(log(1 + apr / 365))) AS chain,
        pow(chain, 365.0 / count()) - 1 AS blendedApy
    FROM daily_accruals
    WHERE customerId = {{ String(customerId, 'cus_demo') }}

TYPE endpoint
