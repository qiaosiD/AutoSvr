DESCRIPTION >
    Today's leaderboard: the latest APY seen for each bank, best first.

NODE latest_per_bank
SQL >
    SELECT
        bankId,
        argMax(bankName, observedAt) AS bankName,
        argMax(apy, observedAt) AS apy,
        argMax(sourceUrl, observedAt) AS sourceUrl,
        max(observedAt) AS observedAt
    FROM rate_observations
    WHERE observedAt >= now() - INTERVAL 2 DAY
    GROUP BY bankId

NODE endpoint
SQL >
    SELECT * FROM latest_per_bank ORDER BY apy DESC

TYPE endpoint
