DESCRIPTION >
    One APY reading for one bank at one point in time, as parsed from a crawl.

SCHEMA >
    `observedAt` DateTime64(3) `json:$.observedAt`,
    `bankId` String `json:$.bankId`,
    `bankName` String `json:$.bankName`,
    `apy` Float64 `json:$.apy`,
    `minBalanceCents` Int64 `json:$.minBalanceCents`,
    `monthlyFeeCents` Int64 `json:$.monthlyFeeCents`,
    `promoExpiresOn` Nullable(String) `json:$.promoExpiresOn`,
    `sourceUrl` String `json:$.sourceUrl`,
    `rawBlobId` Nullable(String) `json:$.rawBlobId`

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(observedAt)"
ENGINE_SORTING_KEY "observedAt, bankId"
