DESCRIPTION >
    A customer's balance moving from one bank to another.

SCHEMA >
    `occurredAt` DateTime64(3) `json:$.occurredAt`,
    `customerId` String `json:$.customerId`,
    `fromBankId` Nullable(String) `json:$.fromBankId`,
    `toBankId` String `json:$.toBankId`,
    `amountCents` Int64 `json:$.amountCents`,
    `aprAtMove` Float64 `json:$.aprAtMove`,
    `reason` String `json:$.reason`

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(occurredAt)"
ENGINE_SORTING_KEY "customerId, occurredAt"
